{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adqwest-me",
  // Revert back to the Angular SSR bundle — it now contains Hono too
  "main": "./dist/server/server.mjs",
  "compatibility_date": "2026-06-02",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adqwest_db",
      "database_id": "7b83dddf-194a-4c86-82c5-68d84ceb7ff1",
      "remote": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SITE_KV",
      "id": "a97ad1cc54984389a3f2149f66ea0b8b"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/browser"
  },
  
  // RESEND_API_KEY is a secret — not declared here
  // Run: wrangler secret put RESEND_API_KEY
  // For local dev create .dev.vars: RESEND_API_KEY=re_your_key_here
  "env": {
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "adqwest_db",
          "database_id": "7b83dddf-194a-4c86-82c5-68d84ceb7ff1"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SITE_KV",
          "id": "a97ad1cc54984389a3f2149f66ea0b8b"
        }
      ],
      "routes": [
        {
          "pattern": "adqwestme.com/*",
          "zone_name": "adqwestme.com"
        }
      ]
    }
  }
}
